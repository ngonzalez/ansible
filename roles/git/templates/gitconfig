[core]
  whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = "#f97298 bold"
  new = "#8bf972 bold"
  whitespace = red reverse
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[alias]
  st = status
  ci = commit
  co = checkout
  ls = ls-files
  # the branches as a timeline: git tree, git tree -20
  tree = log --graph --all --date=short --format='%C(yellow)%h%Creset %C(cyan)%ad%Creset%C(auto)%d%Creset %s'
